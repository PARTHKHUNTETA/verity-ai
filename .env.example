# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (matches docker-compose.yml; local development only) ---
DATABASE_URL=postgres://verity:verity@localhost:5433/verity

# --- Needed from later phases (optional for now) ---
# Phase 2: secret used to sign JWT access tokens (min 32 chars)
JWT_SECRET=
# Phase 4: OpenAI API key for the agent runtime and embeddings
OPENAI_API_KEY=
