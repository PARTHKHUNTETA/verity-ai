# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (matches docker-compose.yml; local development only) ---
DATABASE_URL=postgres://verity:verity@localhost:5433/verity

# --- Auth ---
# Secret used to sign JWT access tokens (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Knowledge base ---
# Uploaded files are stored here (relative to verity-ai-backend/).
STORAGE_DIR=storage
MAX_UPLOAD_MB=25

# --- LLM ---
# "openai" calls the OpenAI API (needs OPENAI_API_KEY). "fake" streams a canned answer for free.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
