# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (matches docker-compose.yml; local development only) ---
DATABASE_URL=postgres://verity:verity@localhost:5433/verity

# --- Auth ---
# Secret used to sign JWT access tokens (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Knowledge base ---
# Uploaded files are stored here (relative to verity-ai-backend/).
STORAGE_DIR=storage
MAX_UPLOAD_MB=25

# --- Discovery (web & academic search) ---
# Web search: "none" or "tavily" (needs TAVILY_API_KEY). Academic search (arXiv) needs no key.
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
ACADEMIC_SEARCH=arxiv
# Optional: higher Semantic Scholar rate limits (add "semantic_scholar" to ACADEMIC_SEARCH)
SEMANTIC_SCHOLAR_API_KEY=
# Comma-separated domains; subdomains included. ALLOWED_DOMAINS (if set) restricts fetching to those.
BLOCKED_DOMAINS=
ALLOWED_DOMAINS=
FETCH_MAX_MB=10
FETCH_TIMEOUT_MS=20000
MAX_SOURCES_PER_RUN=5

# --- LLM ---
# "openai" calls the OpenAI API (needs OPENAI_API_KEY). "fake" streams a canned answer for free.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
